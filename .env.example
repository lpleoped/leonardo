# Copiar a .env (nunca commitear .env). También cargar en Vercel como Secret.

# Spotify Developer Dashboard → App settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Debe coincidir EXACTO con un Redirect URI de la app Spotify.
# Local con `vercel dev`: Spotify no acepta "localhost"; usar 127.0.0.1 (HTTP solo en loopback).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Producción (HTTPS obligatorio fuera del loopback):
# SPOTIFY_REDIRECT_URI=https://tu-dominio.com/api/spotify/callback

# Origen del sitio (post-login redirect a /acerca#banda-sonora)
SITE=http://127.0.0.1:3000
