---
import type { EscenaLugar } from "../lib/camino-visual";

interface Props {
  escena?: EscenaLugar;
  href?: string;
  label?: string;
}

const { escena, href, label } = Astro.props;
---

{
  escena && (
    <div class="paso-marco">
      {href ? (
        <a class="paso-fachada-enlace" href={href} aria-label={label}>
          <img
            class="paso-fachada"
            src={escena.fachada.src}
            alt=""
            width={escena.fachada.width}
            height={escena.fachada.height}
            decoding="async"
          />
        </a>
      ) : (
        <img
          class="paso-fachada"
          src={escena.fachada.src}
          alt=""
          width={escena.fachada.width}
          height={escena.fachada.height}
          decoding="async"
        />
      )}
    </div>
  )
}
