---
import { sitio } from "../site";

interface Props {
  /** Compacto oficial (152). En columna de fotos evita un bloque 352 demasiado alto. */
  compacto?: boolean;
}

const { compacto = false } = Astro.props;
const { tipo, id, titulo } = sitio.spotify;
const src = `https://open.spotify.com/embed/${tipo}/${id}?utm_source=generator&theme=0`;
/* Alturas oficiales Spotify: 152 compacto, 352 lista. */
const alto = compacto || tipo === "track" ? 152 : 352;
---

<figure class="spotify-embed" style={`--spotify-h: ${alto}px`}>
  <iframe
    title={titulo}
    src={src}
    width="100%"
    height={alto}
    frameborder="0"
    allowfullscreen=""
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
  ></iframe>
</figure>
