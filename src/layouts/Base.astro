---
import "../styles/global.css";
import { flecha } from "../lib/flechas";
import { lugaresPublicados } from "../lib/lugares";
import { sitio } from "../site";

interface Props {
  titulo: string;
  tituloEn?: string;
  descripcion: string;
  imagen?: string;
  prefetch?: string;
  indexar?: boolean;
}

const { titulo, tituloEn, descripcion, imagen, prefetch, indexar = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(imagen ?? "/og-image.png", Astro.site).href;
const path = Astro.url.pathname;
const recorrido = await lugaresPublicados();
const secciones = [
  { href: "/acerca", label: "Mi historia", en: "My story" },
  { href: "/proyectos", label: "Mis proyectos", en: "My projects" },
  { href: "/acerca#detras", label: "Otras piezas", en: "Other pieces" },
  { href: "/contacto", label: "Contacto", en: "Contact" },
];
const redes = [
  sitio.behance ? { href: sitio.behance, label: "Behance" } : undefined,
  sitio.linkedin ? { href: sitio.linkedin, label: "LinkedIn" } : undefined,
  sitio.github ? { href: sitio.github, label: "GitHub" } : undefined,
  sitio.instagram ? { href: sitio.instagram, label: "Instagram" } : undefined,
].filter((red) => red !== undefined);

function vigente(href: string) {
  if (href.includes("#")) return false;
  if (href === "/trabajo") return path === "/trabajo" || path.startsWith("/trabajo/");
  if (href === "/proyectos") return path === "/proyectos";
  if (href === "/acerca") return path === "/acerca" || path.startsWith("/acerca/");
  return path === href;
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @media (hover: hover) and (pointer: fine) {
        html, html * { cursor: none !important; }
      }
    </style>
    <meta name="theme-color" content="#14110f" />
    <title data-en={tituloEn}>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!indexar && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical.href} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    {imagenAbsoluta && <meta property="og:image:type" content="image/png" />}
    {imagenAbsoluta && <meta property="og:image:width" content="1200" />}
    {imagenAbsoluta && <meta property="og:image:height" content="1200" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    {imagenAbsoluta && <meta name="twitter:image" content={imagenAbsoluta} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {prefetch && <link rel="prefetch" href={prefetch} />}
  </head>
  <body>
    <a class="saltar" href="#contenido" data-en="Skip to content">Saltar al contenido</a>
    <header class="site-header">
      <a
        class="marca"
        href="/"
        aria-label={`${sitio.nombre}, inicio`}
        data-en-aria-label={`${sitio.nombre}, home`}
      >
        {sitio.marca}<span class="marca-punto">.</span>
      </a>
      <nav id="menu-principal" class="nav" aria-label="Secciones" data-en-aria-label="Sections" data-menu>
        {
          secciones.map((seccion) =>
            seccion.href === "/acerca" ? (
              <div class="nav-item nav-item--historia" data-nav-history>
                <button
                  class="nav-trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls="submenu-historia"
                  aria-current={vigente(seccion.href) ? "page" : undefined}
                  data-en="My story"
                  data-en-aria-label="Open My story menu"
                  aria-label="Abrir menú Mi historia"
                  data-nav-history-trigger
                >
                  <span data-en="My story">Mi historia</span><span class="nav-trigger-icon" aria-hidden="true">↘︎</span>
                </button>
                <div class="nav-submenu" id="submenu-historia" data-nav-history-menu hidden>
                  <a class="nav-submenu-intro" href="/acerca">
                    <span data-en="Overview">Ver la historia completa</span><span aria-hidden="true">↗︎</span>
                  </a>
                  <ul>
                    {recorrido.map((paso, indice) => (
                      <li>
                        <a href={`/acerca/${paso.data.slug}`} data-en={paso.data.lugarEn}>
                          <span class="nav-submenu-number">{String(indice + 1).padStart(2, "0")}</span>
                          <span class="nav-submenu-label">
                            <span data-en={paso.data.lugarEn}>{paso.data.lugar}</span>
                            <small data-en={paso.data.cuandoEn}>{paso.data.cuando}</small>
                          </span>
                          <span class="nav-submenu-arrow" aria-hidden="true">↗︎</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a href={seccion.href} aria-current={vigente(seccion.href) ? "page" : undefined} data-en={seccion.en}>
                {seccion.label}
              </a>
            ),
          )
        }
      </nav>
      <button
        class="idioma"
        type="button"
        aria-label="ES / EN, read in English"
        data-en-aria-label="ES / EN, ver en español"
        data-idioma
      >
        <span lang="es">ES</span><span aria-hidden="true">/</span><span lang="en">EN</span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        data-en-aria-label="Open menu"
        aria-controls="menu-principal"
        aria-expanded="false"
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="footer-firma" href="/">{sitio.nombre}<span aria-hidden="true">{flecha.ne}</span></a>
      <span data-en={sitio.lugarEn}>{sitio.lugar}</span>
      <div class="footer-cierre">
        <div class="footer-redes">
          {
            redes.map((red) => (
              <a href={red.href}>{red.label} {flecha.ne}</a>
            ))
          }
        </div>
      </div>
      <p
        class="footer-atribucion"
        data-en="Third-party trademarks, logos and images belong to their owners. Shown here in a biographical context on this personal site."
      >
        Marcas, logos e imágenes de terceros pertenecen a sus titulares. Se muestran en contexto biográfico en este sitio personal.
      </p>
    </footer>
    <div class="cursor" aria-hidden="true" data-cursor>
      <span class="cursor-ring" data-cursor-ring></span>
      <span class="cursor-dot" data-cursor-dot></span>
    </div>
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const boton = document.querySelector("[data-idioma]");
        const textos = [...document.querySelectorAll("[data-en]")].flatMap((elemento) => {
          const nodo = [...elemento.childNodes].find(
            (hijo) => hijo.nodeType === Node.TEXT_NODE && hijo.textContent.trim(),
          );
          if (!nodo) return [];
          const es = nodo.textContent;
          return [{ nodo, es, en: es.replace(es.trim(), () => elemento.dataset.en) }];
        });
        const atributos = ["aria-label", "alt"].flatMap((nombre) =>
          [...document.querySelectorAll(`[data-en-${nombre}]`)].map((elemento) => ({
            elemento,
            nombre,
            es: elemento.getAttribute(nombre),
            en: elemento.getAttribute(`data-en-${nombre}`),
          })),
        );

        function aplicar(idioma) {
          raiz.lang = idioma;
          for (const texto of textos) texto.nodo.textContent = texto[idioma];
          for (const atributo of atributos) atributo.elemento.setAttribute(atributo.nombre, atributo[idioma]);
        }

        let guardado = null;
        try {
          guardado = localStorage.getItem("idioma");
        } catch {}
        if (guardado === "en") aplicar("en");

        boton.hidden = false;
        boton.addEventListener("click", () => {
          const idioma = raiz.lang === "en" ? "es" : "en";
          aplicar(idioma);
          try {
            localStorage.setItem("idioma", idioma);
          } catch {}
        });

        const menu = document.querySelector("[data-menu]");
        const menuToggle = document.querySelector("[data-menu-toggle]");
        const historyItem = document.querySelector("[data-nav-history]");
        const historyTrigger = document.querySelector("[data-nav-history-trigger]");
        const historyMenu = document.querySelector("[data-nav-history-menu]");
        const enlacesMenu = [...document.querySelectorAll("[data-menu] a")];
        const cerrarHistoria = () => {
          if (!historyItem || !historyTrigger || !historyMenu) return;
          historyItem.dataset.abierto = "false";
          historyTrigger.setAttribute("aria-expanded", "false");
          historyMenu.hidden = true;
        };
        const alternarHistoria = () => {
          if (!historyItem || !historyTrigger || !historyMenu) return;
          const abierto = historyItem.dataset.abierto === "true";
          historyItem.dataset.abierto = String(!abierto);
          historyTrigger.setAttribute("aria-expanded", String(!abierto));
          historyMenu.hidden = abierto;
        };
        historyTrigger?.addEventListener("click", alternarHistoria);
        document.addEventListener("click", (evento) => {
          if (historyItem && !historyItem.contains(evento.target)) cerrarHistoria();
        });
        document.addEventListener("keydown", (evento) => {
          if (evento.key === "Escape") {
            cerrarHistoria();
            historyTrigger?.focus();
          }
        });
        const cerrarMenu = () => {
          if (!menu || !menuToggle) return;
          menu.dataset.abierto = "false";
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", raiz.lang === "en" ? "Open menu" : "Abrir menú");
          menuToggle.classList.remove("is-open");
          cerrarHistoria();
        };
        menuToggle?.addEventListener("click", () => {
          if (!menu) return;
          const abierto = menu.dataset.abierto === "true";
          menu.dataset.abierto = String(!abierto);
          menuToggle.setAttribute("aria-expanded", String(!abierto));
          menuToggle.setAttribute(
            "aria-label",
            raiz.lang === "en" ? (abierto ? "Open menu" : "Close menu") : abierto ? "Abrir menú" : "Cerrar menú",
          );
          menuToggle.classList.toggle("is-open", !abierto);
        });
        enlacesMenu.forEach((enlace) => enlace.addEventListener("click", cerrarMenu));
        window.addEventListener("resize", () => {
          if (window.matchMedia("(min-width: 40.01rem)").matches) cerrarMenu();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const soporte = window.matchMedia("(hover: hover) and (pointer: fine)");
        const reducido = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (!soporte.matches) return;

        const raiz = document.documentElement;
        const cursor = document.querySelector("[data-cursor]");
        const ring = document.querySelector("[data-cursor-ring]");
        const dot = document.querySelector("[data-cursor-dot]");
        if (!cursor || !ring || !dot) return;

        let posicionGuardada = null;
        try {
          posicionGuardada = JSON.parse(sessionStorage.getItem("cursor-position") || "null");
        } catch {}
        let x = posicionGuardada?.x ?? -100;
        let y = posicionGuardada?.y ?? -100;
        let objetivoX = x;
        let objetivoY = y;
        let raf = 0;
        let visible = false;

        const mover = () => {
          x += (objetivoX - x) * (reducido.matches ? 1 : 0.2);
          y += (objetivoY - y) * (reducido.matches ? 1 : 0.2);
          cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          raf = window.requestAnimationFrame(mover);
        };

        const estadoDe = (elemento) => {
          const interactivo = elemento?.closest("a, button, [role='button'], [role='link'], summary, label");
          const editable = elemento?.closest("input, textarea, select, [contenteditable='true']");
          const arrastrable = elemento?.closest("[data-cursor='drag'], [draggable='true']");
          const imagen = elemento?.closest("img, video, figure, [data-cursor='media']");
          if (editable) return "text";
          if (arrastrable) return "drag";
          if (imagen) return "media";
          if (interactivo) return "action";
          return "default";
        };

        const actualizarEstado = (elemento) => {
          raiz.dataset.cursorState = estadoDe(elemento);
        };

        const entrar = () => {
          visible = true;
          cursor.classList.add("is-visible");
          if (!raf) raf = window.requestAnimationFrame(mover);
        };

        const salir = () => {
          visible = false;
          cursor.classList.remove("is-visible");
          raiz.dataset.cursorState = "default";
        };

        window.addEventListener("pointermove", (evento) => {
          objetivoX = evento.clientX;
          objetivoY = evento.clientY;
          if (!visible) entrar();
          actualizarEstado(document.elementFromPoint(evento.clientX, evento.clientY));
        }, { passive: true });
        window.addEventListener("pointerdown", (evento) => {
          try {
            sessionStorage.setItem("cursor-position", JSON.stringify({ x: evento.clientX, y: evento.clientY }));
          } catch {}
        }, { passive: true });
        window.addEventListener("pointerover", entrar, { passive: true });
        window.addEventListener("pointerout", (evento) => {
          if (!evento.relatedTarget) salir();
        }, { passive: true });
        window.addEventListener("blur", salir);
        window.addEventListener("pageshow", entrar, { passive: true });
        reducido.addEventListener?.("change", () => {
          if (reducido.matches) raiz.dataset.cursorMotion = "reduced";
        });
        raiz.dataset.cursorMotion = reducido.matches ? "reduced" : "full";
        if (posicionGuardada) entrar();
      })();
    </script>
  </body>
</html>
