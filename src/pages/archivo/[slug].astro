---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import FacetaMosaico from "../../components/FacetaMosaico.astro";
import { facetasConFicha } from "../../lib/facetas";
import { mosaicosFaceta, retratosPersona } from "../../lib/faceta-mosaico";
import { flecha } from "../../lib/flechas";
import { sitio } from "../../site";

export async function getStaticPaths() {
  const facetas = await facetasConFicha();
  return facetas.map((faceta) => ({
    params: { slug: faceta.data.slug },
    props: { id: faceta.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const facetas = await facetasConFicha();
const indice = facetas.findIndex((faceta) => faceta.id === id);
const faceta = facetas[indice];
if (!faceta) {
  throw new Error("Faceta no encontrada");
}

const anterior = indice > 0 ? facetas[indice - 1] : undefined;
const siguiente = indice < facetas.length - 1 ? facetas[indice + 1] : undefined;
const tieneMosaico = Boolean(mosaicosFaceta[faceta.data.slug]);
---

<Base
  titulo={`${faceta.data.titulo} — ${sitio.nombre}`}
  tituloEn={`${faceta.data.tituloEn} — ${sitio.nombre}`}
  descripcion={faceta.data.detalle}
>
  <article class="lugar faceta-ficha">
    <header class="lugar-cabecera">
      <a class="lugar-volver" href="/acerca#detras" data-en="The archive"><span aria-hidden="true">{flecha.izq}</span>El archivo</a>
      <h1 class="lugar-titulo" data-en={faceta.data.tituloEn}>{faceta.data.titulo}</h1>
      <p class="lugar-detalle" data-en={faceta.data.detalleEn}>{faceta.data.detalle}</p>
    </header>
    {tieneMosaico && <FacetaMosaico slug={faceta.data.slug} />}
    {
      faceta.data.personas.length > 0 && (
        <ul class="faceta-personas">
          {faceta.data.personas.map((persona) => {
            const retrato = retratosPersona[persona.nombre];
            const [formal, ...restNombre] = persona.nombre.split("\n");
            const apodo = restNombre.join(" ").trim();
            return (
              <li>
                {retrato && (
                  <div
                    class="faceta-persona-foto"
                    style={`--pos: ${retrato.posicion ?? "center"}; --ratio: ${retrato.ratio ?? `${retrato.imagen.width} / ${retrato.imagen.height}`}; --fit: ${retrato.fit ?? "cover"}`}
                  >
                    <Image
                      src={retrato.imagen}
                      width={retrato.imagen.width}
                      height={retrato.imagen.height}
                      alt={retrato.alt}
                      data-en-alt={retrato.altEn}
                      widths={[640, 960, 1280, 1600]}
                      sizes="(max-width: 40rem) calc(100vw - 2.5rem), 28rem"
                      format="webp"
                      quality={84}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="faceta-persona-texto">
                  <h2>
                    {formal}
                    {apodo && <span class="faceta-persona-apodo">{apodo}</span>}
                  </h2>
                  <p data-en={persona.notaEn}>{persona.nota}</p>
                  {persona.enlace && (
                    <a class="detras-enlace" href={persona.enlace} rel="noopener noreferrer" target="_blank" data-en={persona.enlaceEtiquetaEn}>
                      {persona.enlaceEtiqueta} <span aria-hidden="true">{flecha.ne}</span>
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
    <ol class="lugar-escenas">
      {
        faceta.data.escenas.map((escena) => {
          const nombresDivididos =
            escena.id === "los-mios" && escena.texto.includes("|")
              ? escena.texto.split("|").map((nombre) => nombre.trim()).filter(Boolean)
              : null;
          return (
            <li id={escena.id}>
              <h2 data-en={escena.tituloEn}>{escena.titulo}</h2>
              {nombresDivididos ? (
                <ul class="faceta-los-mios" aria-label={escena.texto.replaceAll("|", ", ")}>
                  {nombresDivididos.map((nombre) => (
                    <li>{nombre}</li>
                  ))}
                </ul>
              ) : (
                <p data-en={escena.textoEn}>{escena.texto}</p>
              )}
            </li>
          );
        })
      }
    </ol>
    {
      faceta.data.videos.length > 0 && (
        <ul class="faceta-videos">
          {faceta.data.videos.map((video) => (
            <li>
              <a class={`faceta-video faceta-video--${video.forma}`} href={video.url} rel="noopener noreferrer" target="_blank">
                <span class="faceta-video-foto">
                  <Image
                    src={video.poster}
                    width={video.poster.width}
                    height={video.poster.height}
                    alt={video.posterAlt}
                    data-en-alt={video.posterAltEn}
                    widths={[640, 960, 1280, 1600]}
                    sizes="(max-width: 40rem) calc(100vw - 2.5rem), 34rem"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="faceta-video-play" aria-hidden="true">▶</span>
                </span>
                <h2>{video.titulo}</h2>
                <p data-en={video.notaEn}>{video.nota}</p>
                <span class="faceta-video-ir" data-en="Watch on YouTube">Ver en YouTube <span aria-hidden="true">{flecha.ne}</span></span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      (anterior || siguiente) && (
        <nav class="lugar-vecinos" aria-label="Otras facetas" data-en-aria-label="Other facets">
          {
            anterior && (
              <a class="lugar-vecino" href={`/archivo/${anterior.data.slug}`} data-en={anterior.data.tituloEn}>
                {anterior.data.titulo}
              </a>
            )
          }
          {
            siguiente && (
              <a class="lugar-vecino lugar-vecino-siguiente" href={`/archivo/${siguiente.data.slug}`} data-en={siguiente.data.tituloEn}>
                {siguiente.data.titulo}
              </a>
            )
          }
        </nav>
      )
    }
  </article>
</Base>
