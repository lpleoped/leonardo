---
import Base from "../layouts/Base.astro";
import { flecha } from "../lib/flechas";
import { sitio } from "../site";

const canales = [
  sitio.behance
    ? { href: sitio.behance, nota: "Archivo", notaEn: "Archive", nombre: "Behance", clase: undefined }
    : undefined,
  sitio.linkedin
    ? { href: sitio.linkedin, nota: "Perfil", notaEn: "Profile", nombre: "LinkedIn", clase: undefined }
    : undefined,
  sitio.github
    ? { href: sitio.github, nota: "Código", notaEn: "Code", nombre: "GitHub", clase: undefined }
    : undefined,
  sitio.instagram
    ? { href: sitio.instagram, nota: "Red", notaEn: "Social", nombre: "Instagram", clase: undefined }
    : undefined,
].filter((canal) => canal !== undefined);
---

<Base titulo={`Contacto — ${sitio.nombre}`} tituloEn={`Contact — ${sitio.nombre}`} descripcion={sitio.frase}>
  <div class="contacto-intro"><p class="eyebrow" data-en="Every idea starts with a chat">Toda idea empieza con una charla</p>
  <h1 class="pagina-titulo" data-en="Let's make">Hagamos<br /><em data-en="things happen.">que suceda.</em></h1>
  </div>
  <div class="contacto">
    {
      canales.map((canal) => (
        <a class={canal.clase} href={canal.href}>
          <span data-en={canal.notaEn}>{canal.nota}</span>
          {canal.nombre}
          <span aria-hidden="true">{flecha.ne}</span>
        </a>
      ))
    }
  </div>
  {
    sitio.email && (
      <p class="contacto-personal">
        <span data-en="Or write me here: ">Si no, podés escribirme por acá: </span>
        <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
      </p>
    )
  }
</Base>
